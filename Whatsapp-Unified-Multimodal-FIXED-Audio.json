        "jsCode": "// === ÁUDIO TRANSCRITO ===\nconst transcription = $json.text || '';\nconst webhookData = $('Webhook OpenWA').item.json.body;\nconst data = webhookData.data || {};\n\nif (!transcription || transcription.trim() === '') {\n  console.log('[AUDIO] Transcrição vazia');\n  return {\n    json: {\n      skip: true,\n      reason: 'Transcrição vazia'\n    }\n  };\n}\n\nreturn {\n  json: {\n    chatId: data.chatId,\n    from: data.from,\n    messageId: data.id,\n    text: `[🎤 ÁUDIO]\\n${transcription}`,\n    inputType: 'voice',\n    timestamp: data.timestamp\n  }\n};"
      },
