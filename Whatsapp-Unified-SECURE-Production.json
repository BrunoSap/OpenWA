        "jsCode": "// === TEXTO ===\nconst body = $('Webhook OpenWA').item.json.body;\nconst data = body.data || {};\n\nconsole.log('[TEXT] chatId:', data.chatId);\nconsole.log('[TEXT] message:', data.body);\n\nreturn {\n  json: {\n    chatId: data.chatId,\n    from: data.from,\n    messageId: data.id,\n    text: data.body || '',\n    inputType: 'text'\n  }\n};"
