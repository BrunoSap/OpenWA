      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1000, 300],
      "id": "detect-contamination",
      "name": "🚨 SECURITY: Detect Contamination"
    },
    {
      "parameters": {
        "jsCode": "// ===================================================================\n// 🔒 SANITIZAÇÃO CRÍTICA DE SEGURANÇA\n// ===================================================================\n// Remove TODA informação sensível que nunca deve vazar para o cliente:\n// 1. Tags de raciocínio interno do modelo (<think>, <thinking>, etc)\n// 2. Chain-of-thought exposto\n// 3. Metadados de prompt ou lógica de negócio\n// 4. Dados sensíveis (CPF, CNPJ, documentos, números de conta, etc)\n// ===================================================================\n\nlet output = $json.output || '';\n\n// === STEP 1: Remove tags de raciocínio interno ===\nconst thinkingPatterns = [\n  /<think>.*?<\\/think>/gis,\n  /<thinking>.*?<\\/thinking>/gis,\n  /\\[THINKING\\].*?\\[\\/THINKING\\]/gis,\n  /\\(thinking:.*?\\)/gis,\n  /Chain of thought:.*?(?=\\n\\n|$)/gis,\n  /Here's my thinking:.*?(?=\\n\\n|$)/gis,\n  /Mental process:.*?(?=\\n\\n|$)/gis,\n  /Reasoning:.*?(?=\\n\\n|$)/gis\n];\n\nthinkingPatterns.forEach(pattern => {\n  output = output.replace(pattern, '');\n});\n\n// === STEP 2: Remove dados sensíveis (PII) ===\nconst piiPatterns = [\n  // CPF (formato: 000.000.000-00 ou 00000000000)\n  { pattern: /\\b\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}\\b/g, replacement: '[CPF REDACTED]' },\n  { pattern: /\\b\\d{11}\\b/g, replacement: '[CPF REDACTED]' },\n  // CNPJ (formato: 00.000.000/0000-00 ou 00000000000000)\n  { pattern: /\\b\\d{2}\\.\\d{3}\\.\\d{3}\\/\\d{4}-\\d{2}\\b/g, replacement: '[CNPJ REDACTED]' },\n  { pattern: /\\b\\d{14}\\b/g, replacement: '[CNPJ REDACTED]' },\n  // RENAVAM (11 dígitos)\n  { pattern: /\\bRENAVAM:\\s*\\d{11}\\b/gi, replacement: 'RENAVAM: [REDACTED]' },\n  // Placas de veículos (formato: ABC1234 ou ABC-1234)\n  { pattern: /\\b[A-Z]{3}[-\\s]?\\d[A-Z0-9]\\d{2}\\b/g, replacement: '[PLACA REDACTED]' },\n  // Números de conta bancária (genérico: 4-12 dígitos)\n  { pattern: /\\bConta:\\s*\\d{4,12}\\b/gi, replacement: 'Conta: [REDACTED]' },\n  // Emails\n  { pattern: /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b/g, replacement: '[EMAIL REDACTED]' },\n  // Telefones BR (formato: (00) 00000-0000 ou 00000000000)\n  { pattern: /\\(?\\d{2}\\)?\\s?\\d{4,5}-?\\d{4}/g, replacement: '[TELEFONE REDACTED]' },\n  // Valores monetários altos (> R$ 1000) - pode indicar dados sensíveis\n  { pattern: /R\\$\\s*\\d{1,3}(?:\\.\\d{3})+,\\d{2}/g, replacement: 'R$ [VALOR REDACTED]' }\n];\n\npiiPatterns.forEach(({ pattern, replacement }) => {\n  output = output.replace(pattern, replacement);\n});\n\n// === STEP 3: Remove nomes próprios SE houver contexto de documento ===\n// (Evita falsos positivos com nomes genéricos em conversas normais)\nif (output.match(/documento|IPVA|RENAVAM|Placa|CPF|CNPJ/gi)) {\n  // Remove padrão \"Nome: [Nome Completo]\"\n  output = output.replace(/Nome:\\s*[A-Z][a-zà-ú]+(?:\\s[A-Z][a-zà-ú]+)+/gi, 'Nome: [REDACTED]');\n  // Remove padrão \"Contribuinte: [Nome Completo]\"\n  output = output.replace(/Contribuinte:\\s*[A-Z][a-zà-ú]+(?:\\s[A-Z][a-zà-ú]+)+/gi, 'Contribuinte: [REDACTED]');\n}\n\n// === STEP 4: Limpa espaços em branco e quebras duplicadas ===\noutput = output\n  .replace(/\\n{3,}/g, '\\n\\n')  // Max 2 quebras de linha consecutivas\n  .replace(/^\\s+|\\s+$/g, '')   // Trim início e fim\n  .trim();\n\n// === STEP 5: Validação final - se output ficou vazio ou muito curto ===\nif (!output || output.length < 10) {\n  output = 'Desculpe, houve um problema ao processar sua mensagem. Pode tentar novamente?';\n}\n\n// === STEP 6: Log de auditoria (NÃO expõe dados sensíveis) ===\nconst hadThinking = $json.output.match(/<think>|<thinking>/i) !== null;\nconst hadPII = piiPatterns.some(({ pattern }) => $json.output.match(pattern));\n\nconsole.log('[SECURITY] Sanitization applied:', {\n  hadThinking,\n  hadPII,\n  originalLength: $json.output.length,\n  cleanLength: output.length,\n  chatId: $('Merge Inputs').item.json.chatId,\n  timestamp: new Date().toISOString()\n});\n\n// === OUTPUT LIMPO E SEGURO ===\nreturn {\n  json: {\n    chatId: $('Merge Inputs').item.json.chatId,\n    text: output,\n    sanitized: true,\n    hadThinking,\n    hadPII\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 200],
      "id": "sanitize-output",
      "name": "🔒 SANITIZE Output"
    },
    {
      "parameters": {
        "jsCode": "// Fallback: se passou direto (sem contaminação detectada), ainda aplica sanitização básica\nlet output = $json.output || '';\n\n// Remove apenas tags de raciocínio (sanitização leve)\noutput = output\n  .replace(/<think>.*?<\\/think>/gis, '')\n  .replace(/<thinking>.*?<\\/thinking>/gis, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn {\n  json: {\n    chatId: $('Merge Inputs').item.json.chatId,\n    text: output,\n    sanitized: false\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 400],
