      "parameters": {
        "jsCode": "const body = $('Webhook OpenWA').item.json.body;\nconst data = body.data || {};\nconst transcription = $json.text || '';\n\nreturn {\n  json: {\n    chatId: data.chatId,\n    from: data.from,\n    messageId: data.id,\n    text: `[🎤 ÁUDIO TRANSCRITO]\\n${transcription}`,\n    inputType: 'voice'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 300],
      "id": "format-audio",
      "name": "Formatar Áudio"
    },
    {
      "parameters": {
        "jsCode": "// === IMAGEM ===\nconst body = $('Webhook OpenWA').item.json.body;\nconst data = body.data || {};\nconst media = data.media || {};\n\nif (!media.data) {\n  throw new Error('media.data ausente');\n}\n\nlet imageBase64 = media.data;\nif (imageBase64.includes(',')) {\n  imageBase64 = imageBase64.split(',')[1];\n}\n\nconst imageBuffer = Buffer.from(imageBase64, 'base64');\n\nreturn {\n  json: {\n    chatId: data.chatId,\n    from: data.from,\n    messageId: data.id,\n    caption: data.caption || 'Descreva esta imagem em detalhes',\n    inputType: 'image'\n  },\n  binary: {\n    data: {\n      data: imageBuffer.toString('base64'),\n      mimeType: media.mimetype || 'image/jpeg',\n      fileName: 'image.jpg'\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 460],
      "id": "process-image",
      "name": "Processar Imagem"
    },
