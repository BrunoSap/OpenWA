      "parameters": {
        "jsCode": "// === ÁUDIO ===\nconst body = $('Webhook OpenWA').item.json.body;\nconst data = body.data || {};\nconst media = data.media || {};\n\nif (!media.data) {\n  throw new Error('media.data ausente');\n}\n\nconst audioBase64 = media.data;\nconst audioBuffer = Buffer.from(audioBase64, 'base64');\n\nreturn {\n  json: {\n    chatId: data.chatId,\n    from: data.from,\n    messageId: data.id,\n    inputType: 'voice'\n  },\n  binary: {\n    data: {\n      data: audioBuffer.toString('base64'),\n      mimeType: media.mimetype || 'audio/ogg',\n      fileName: 'audio.ogg'\n    }\n  }\n};"
      },
